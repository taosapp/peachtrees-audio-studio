# ================================================
# PeachTrees Media Studio - macOS 配置模板
# 复制为 backend/.env 后使用，路径需改为实际绝对路径
# ================================================

# ---------- 环境 ----------
APP_NAME=PeachTrees Media Studio
APP_ENV=development

# ---------- 数据库 ----------
# macOS 路径示例（用户名按实际替换）
DATABASE_URL=sqlite+aiosqlite:///Users/your_username/peachtreesMediaStudio/backend/data/pt_media_studio.db

# ---------- 业务限制 ----------
MAX_UPLOAD_MB=50
MAX_REF_SECONDS=15
MAX_OUTPUT_FILES=500
# macOS MPS 模式下建议设为 0（由 torch 自行管理 MPS 并行度）
TTS_NUM_THREADS=0
