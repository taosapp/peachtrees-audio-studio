# ================================================
# PeachTrees Media Studio - Linux 配置模板
# 复制为 backend/.env 后使用，路径需改为实际绝对路径
# ================================================

# ---------- 环境 ----------
APP_NAME=PeachTrees Media Studio
APP_ENV=development

# ---------- 数据库 ----------
# Linux 路径示例
DATABASE_URL=sqlite+aiosqlite:///home/your_username/peachtreesMediaStudio/backend/data/pt_media_studio.db

# ---------- 业务限制 ----------
MAX_UPLOAD_MB=50
MAX_REF_SECONDS=15
MAX_OUTPUT_FILES=500
# CPU 推理线程数（GPU 模式下影响小，0=torch 默认）
TTS_NUM_THREADS=4
