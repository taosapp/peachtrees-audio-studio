# ================================================
# PeachTrees Media Studio - Backend 配置 (样例)
# ================================================

# ---------- 环境 ----------
APP_NAME=PeachTrees Media Studio
APP_ENV=development

# ---------- 数据库 ----------
# 仅支持 SQLite（零配置，文件位于 backend/data/pt_media_studio.db，自动创建）
DATABASE_URL=sqlite+aiosqlite:///D:/ai/peachtreesMediaStudio/backend/data/pt_media_studio.db

# ---------- 业务限制 ----------
# 参考音频上传大小上限（MB）
MAX_UPLOAD_MB=50
# 参考音频最大时长（秒），超出自动截断
MAX_REF_SECONDS=15
# 合成输出目录最多保留文件数，超出自动清理最旧文件
MAX_OUTPUT_FILES=500
# 推理线程数（CPU 模式并行度，0=torch 默认）
TTS_NUM_THREADS=4
